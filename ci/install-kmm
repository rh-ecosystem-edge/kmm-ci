#!/usr/bin/env bash

set -euo pipefail

KMM_NAMESPACE="${KMM_NAMESPACE:-openshift-kmm}"
KMM_SUBSCRIPTION_NAME="${KMM_SUBSCRIPTION_NAME:-kernel-module-management-subscription}"
KMM_PACKAGE_NAME="${KMM_PACKAGE_NAME:-kernel-module-management}"
KMM_CATALOG_SOURCE="${KMM_CATALOG_SOURCE:-redhat-operators}"
KMM_CATALOG_NAMESPACE="${KMM_CATALOG_NAMESPACE:-openshift-marketplace}"
KMM_MARKETPLACE_TIMEOUT="${KMM_MARKETPLACE_TIMEOUT:-10m}"
KMM_READINESS_RETRIES="${KMM_READINESS_RETRIES:-60}"
KMM_READINESS_INTERVAL="${KMM_READINESS_INTERVAL:-10}"
KMM_PACKAGE_SELECTOR="catalog=${KMM_CATALOG_SOURCE},catalog-namespace=${KMM_CATALOG_NAMESPACE}"

echo "Installing ${KMM_PACKAGE_NAME} from ${KMM_CATALOG_SOURCE}"

print_marketplace_diagnostics() {
  oc get clusteroperator marketplace -o yaml || true
  oc get catalogsource "${KMM_CATALOG_SOURCE}" \
    --namespace "${KMM_CATALOG_NAMESPACE}" -o yaml || true
  oc get pods --namespace "${KMM_CATALOG_NAMESPACE}" -o wide || true
  oc api-resources --api-group=packages.operators.coreos.com || true
}

duration_to_seconds() {
  local duration="$1"
  local total=0
  local value
  local unit

  while [[ -n "${duration}" ]]; do
    if [[ "${duration}" =~ ^([0-9]+)(h|m|s)(.*)$ ]]; then
      value="${BASH_REMATCH[1]}"
      unit="${BASH_REMATCH[2]}"
      duration="${BASH_REMATCH[3]}"
      case "${unit}" in
        h) total=$((total + value * 3600)) ;;
        m) total=$((total + value * 60)) ;;
        s) total=$((total + value)) ;;
      esac
    else
      return 1
    fi
  done

  printf '%s\n' "${total}"
}

echo "Waiting for the Marketplace operator"
if ! marketplace_timeout_seconds="$(duration_to_seconds "${KMM_MARKETPLACE_TIMEOUT}")" || \
  (( marketplace_timeout_seconds <= 0 )); then
  echo "Invalid Marketplace timeout: ${KMM_MARKETPLACE_TIMEOUT}" >&2
  exit 1
fi

marketplace_deadline=$(( $(date +%s) + marketplace_timeout_seconds ))
remaining_timeout=$(( marketplace_deadline - $(date +%s) ))
if ! oc wait clusteroperator/marketplace \
  --for=create --timeout="${remaining_timeout}s"; then
  echo "The Marketplace operator was not created before the readiness deadline" >&2
  print_marketplace_diagnostics
  exit 1
fi

remaining_timeout=$(( marketplace_deadline - $(date +%s) ))
if (( remaining_timeout <= 0 )) || ! oc wait clusteroperator/marketplace \
  --for=condition=Available=True --timeout="${remaining_timeout}s"; then
  echo "The Marketplace operator did not become available" >&2
  print_marketplace_diagnostics
  exit 1
fi

echo "Waiting for CatalogSource ${KMM_CATALOG_SOURCE}"
catalog_available=false
catalog_state=""
for _ in $(seq 1 "${KMM_READINESS_RETRIES}"); do
  if oc get catalogsource "${KMM_CATALOG_SOURCE}" \
    --namespace "${KMM_CATALOG_NAMESPACE}" >/dev/null 2>&1; then
    catalog_available=true
    catalog_state="$(oc get catalogsource "${KMM_CATALOG_SOURCE}" \
      --namespace "${KMM_CATALOG_NAMESPACE}" \
      -o jsonpath='{.status.connectionState.lastObservedState}' 2>/dev/null || true)"
    if [[ "${catalog_state}" == "READY" ]]; then
      break
    fi
  fi
  sleep "${KMM_READINESS_INTERVAL}"
done

if [[ "${catalog_available}" != true || "${catalog_state}" != "READY" ]]; then
  echo "CatalogSource ${KMM_CATALOG_SOURCE} is not READY" >&2
  print_marketplace_diagnostics
  exit 1
fi

echo "Waiting for the PackageManifest API"
package_api_available=false
for _ in $(seq 1 "${KMM_READINESS_RETRIES}"); do
  if oc api-resources --api-group=packages.operators.coreos.com --no-headers 2>/dev/null \
    | awk '$1 == "packagemanifests" {found=1} END {exit !found}'; then
    package_api_available=true
    break
  fi
  sleep "${KMM_READINESS_INTERVAL}"
done

if [[ "${package_api_available}" != true ]]; then
  echo "The PackageManifest API is unavailable" >&2
  print_marketplace_diagnostics
  exit 1
fi

echo "Waiting for PackageManifest ${KMM_PACKAGE_NAME}"
package_available=false
for _ in $(seq 1 "${KMM_READINESS_RETRIES}"); do
  package_manifest_name="$(oc get packagemanifest \
    --namespace "${KMM_CATALOG_NAMESPACE}" \
    --selector "${KMM_PACKAGE_SELECTOR}" \
    --field-selector "metadata.name=${KMM_PACKAGE_NAME}" \
    -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)"
  if [[ "${package_manifest_name}" == "${KMM_PACKAGE_NAME}" ]]; then
    package_available=true
    break
  fi
  sleep "${KMM_READINESS_INTERVAL}"
done

if [[ "${package_available}" != true ]]; then
  echo "PackageManifest ${KMM_PACKAGE_NAME} is not available from ${KMM_CATALOG_SOURCE}" >&2
  print_marketplace_diagnostics
  exit 1
fi

oc create namespace "${KMM_NAMESPACE}" --dry-run=client -o yaml | oc apply -f -

default_channel="$(oc get packagemanifest \
  --namespace "${KMM_CATALOG_NAMESPACE}" \
  --selector "${KMM_PACKAGE_SELECTOR}" \
  --field-selector "metadata.name=${KMM_PACKAGE_NAME}" \
  -o jsonpath='{.items[0].status.defaultChannel}')"
KMM_CHANNEL="${KMM_CHANNEL:-${default_channel}}"

if [[ -z "${KMM_CHANNEL}" ]]; then
  echo "Unable to determine an OLM channel for ${KMM_PACKAGE_NAME}" >&2
  exit 1
fi

oc apply -f - <<EOF
apiVersion: operators.coreos.com/v1
kind: OperatorGroup
metadata:
  name: kmm-operator-group
  namespace: ${KMM_NAMESPACE}
---
apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: ${KMM_SUBSCRIPTION_NAME}
  namespace: ${KMM_NAMESPACE}
spec:
  channel: ${KMM_CHANNEL}
  name: ${KMM_PACKAGE_NAME}
  source: ${KMM_CATALOG_SOURCE}
  sourceNamespace: ${KMM_CATALOG_NAMESPACE}
  installPlanApproval: Automatic
EOF

echo "Waiting for the KMM CSV to be installed"
csv=""
for _ in {1..90}; do
  csv="$(oc get subscription "${KMM_SUBSCRIPTION_NAME}" \
    --namespace "${KMM_NAMESPACE}" \
    -o jsonpath='{.status.currentCSV}' 2>/dev/null || true)"
  if [[ -n "${csv}" ]]; then
    break
  fi
  sleep 10
done

if [[ -z "${csv}" ]]; then
  oc get subscription,csv,installplan --namespace "${KMM_NAMESPACE}" || true
  echo "KMM did not produce a current CSV" >&2
  exit 1
fi

oc wait --for=jsonpath='{.status.phase}'=Succeeded \
  "csv/${csv}" --namespace "${KMM_NAMESPACE}" --timeout=15m

# Deployment names are part of the installed CSV and have changed between KMM
# releases (for example, the webhook deployment is currently named
# kmm-operator-webhook). Read them from the CSV instead of hard-coding names.
if ! deployment_names="$(oc get csv "${csv}" \
  --namespace "${KMM_NAMESPACE}" \
  -o jsonpath='{range .spec.install.spec.deployments[*]}{.name}{"\n"}{end}')"; then
  echo "Failed to read deployment names from KMM CSV ${csv}" >&2
  exit 1
fi

if [[ -z "${deployment_names}" ]]; then
  oc get csv "${csv}" --namespace "${KMM_NAMESPACE}" -o yaml || true
  echo "KMM CSV ${csv} does not declare any deployments" >&2
  exit 1
fi

mapfile -t deployments <<< "${deployment_names}"

echo "Waiting for KMM deployments: ${deployments[*]}"
for deployment in "${deployments[@]}"; do
  oc wait --for=condition=Available \
    "deployment.apps/${deployment}" \
    --namespace "${KMM_NAMESPACE}" --timeout=10m
done

oc get csv "${csv}" --namespace "${KMM_NAMESPACE}"
